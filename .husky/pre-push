#!/usr/bin/env sh

echo "🚀 푸시 전 최종 검증..."

# TypeScript 타입 체크
echo "📝 TypeScript 검사 중..."
npm run typecheck || exit 1

# ESLint 검사
echo "📋 ESLint 검사 중..."
npm run lint || exit 1

# 테스트 실행
echo "🧪 테스트 실행 중..."
npm run test:run || exit 1

# 빌드 테스트
